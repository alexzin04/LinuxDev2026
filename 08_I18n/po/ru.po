#: src/guess-number.c:22
msgid "Think of a number from 1 to 100."
msgstr "Загадайте число от 1 до 100."

#: src/guess-number.c:25
#, c-format
msgid "Is your number greater than %d? (%s/%s): "
msgstr "Ваше число больше %d? (%s/%s): "

#: src/guess-number.c:26 src/guess-number.c:38 src/guess-number.c:39
#: src/guess-number.c:46
msgid "Yes"
msgstr "Да"

#: src/guess-number.c:26 src/guess-number.c:41 src/guess-number.c:42
#: src/guess-number.c:46
msgid "No"
msgstr "Нет"

#: src/guess-number.c:30
msgid "Error: cannot read standard input.\n"
msgstr "Ошибка: не удалось прочитать стандартный ввод.\n"

#: src/guess-number.c:31
msgid "Error: standard input is closed.\n"
msgstr "Ошибка: стандартный ввод закрыт.\n"

#: src/guess-number.c:45
#, c-format
msgid "Error: enter exactly '%s' or '%s'.\n"
msgstr "Ошибка: введите ровно «%s» или «%s».\n"

#: src/guess-number.c:48
#, c-format
msgid "Your number is %d!\n"
msgstr "Ваше число — %d!\n"
